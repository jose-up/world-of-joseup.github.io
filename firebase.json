{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.mp4",
        "headers": [
          {
            "key": "Content-Type",
            "value": "video/mp4"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/", "destination": "/forms/main.html" },
      { "source": "/main.html", "destination": "/forms/main.html" },
      { "source": "/subsections/codingprojects.html", "destination": "/forms/subsections/codingprojects.html" },
      { "source": "/subsections/contentcreation.html", "destination": "/forms/subsections/contentcreation.html" },
      { "source": "/subsections/more.html", "destination": "/forms/subsections/more.html" },
      { "source": "/budgetmanagement.html", "destination": "/forms/subsections/webapps/budgetmanagement.html" },
      { "source": "/coding-projects", "destination": "/forms/subsections/codingprojects.html" },
      { "source": "/coding-projects/budget-management-tool", "destination": "/forms/subsections/webapps/budgetmanagement.html" },
      { "source": "/content-creation", "destination": "/forms/subsections/contentcreation.html" },
      { "source": "/more", "destination": "/forms/subsections/more.html" }
    ]
  }
}
